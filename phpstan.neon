includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon
    # Temporary baseline of pre-existing errors — burn down over time, do not add to it
    - phpstan-baseline.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - tests/

    level: 7

    # Let Larastan infer model column types from the migration files
    databaseMigrationsPath:
        - database/migrations

    # Pest DSL uses a fluent higher-order TestCall proxy (PendingCalls) that PHPStan
    # cannot statically resolve without an official PHPStan extension.
    # The 400+ dynamic methods (post, get, actingAs, assertDatabaseHas, etc.) are
    # validated at runtime by running the test suite; here we suppress static false
    # positives ONLY for test files so that scope-inclusive PHPStan passes.
    excludePaths:
        analyseAndScan:
            - tests/*
